# Option A: SQLite (local dev default)
DATABASE_URL=sqlite:///./data/creator_discovery.db

# Option B: Supabase — set URL + anon key + database password (backend auto-builds Postgres URI)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_DB_PASSWORD=your-database-password
# Copy pooler host from Dashboard → Database → Connection string (Session mode)
# SUPABASE_POOLER_HOST=aws-1-us-east-1.pooler.supabase.com
# SUPABASE_POOLER_PORT=5432

# Option C: explicit Postgres URI (local Docker or Supabase)
# DATABASE_URL=postgresql://creator:creator@localhost:5432/creator_discovery
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# OpenAI-compatible API (required for LLM categorization)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Creator discovery (automatic — no CSV required)
# Tavily improves search quality; DuckDuckGo is used as free fallback
TAVILY_API_KEY=
YOUTUBE_API_KEY=
USE_MOCK_DISCOVERY=false

# App settings
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:3000,https://fluencerfinder.pages.dev

# Privacy: keep false on any public deployment. When false, scraped contact
# emails are stripped from all API responses and exports. Set true only on a
# private/trusted instance where you need emails for outreach.
EXPOSE_CONTACT_EMAILS=false

# Security. When Supabase is configured, write/paid endpoints require a valid
# Supabase session token. Admin endpoints (ingest, classify, imports, identity,
# exports) additionally require the caller's email to be in this allowlist —
# set it to your own email, or those endpoints stay locked (403). Comma-separated.
ADMIN_EMAILS=
# Per-user requests/minute allowed on the paid /search endpoint.
SEARCH_RATE_LIMIT_PER_MIN=20
# Expose Swagger /docs & /openapi.json. Leave false in production.
ENABLE_DOCS=false
