# Frontend env. Copy to .env.local (gitignored) to override for local dev.

# Where `npm run dev` proxies API calls (/accounts, /search, ...).
# Default: http://127.0.0.1:8000 (run a local backend with uvicorn).
# Set this to a deployed backend URL to develop the UI without a local backend:
# VITE_DEV_API=https://your-backend.run.app

# Supabase (only needed if you change projects; defaults are baked into supabase.ts):
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
